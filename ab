import { useState, useEffect, useMemo } from "react";
import { PieChart, Pie, Cell, ResponsiveContainer, Tooltip, BarChart, Bar, XAxis, YAxis, CartesianGrid } from "recharts";
import { Wallet, Plus, LogOut, User, TrendingUp, TrendingDown, Trash2, Users, LayoutGrid, Receipt, Lock, X } from "lucide-react";

const FONT_IMPORT = `@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap');`;

const PALETTE = ["#1F4D3E", "#B0693F", "#3A6B8A", "#8A5A9E", "#C1503D", "#6B7F3A", "#9E7A3A", "#3A7360"];

const EXPENSE_CATEGORIES = ["Moradia", "Alimentação", "Transporte", "Saúde", "Educação", "Lazer", "Outros"];
const INCOME_CATEGORIES = ["Salário", "Extra", "Investimentos", "Outros"];

const MEMBERS_KEY = "family-members";
const TX_KEY = "family-transactions";

const DEFAULT_MEMBERS = [
  { id: "mae", name: "Mãe", color: "#B0693F" },
  { id: "pai", name: "Pai", color: "#1F4D3E" },
  { id: "filho", name: "Filho", color: "#3A6B8A" },
  { id: "filha", name: "Filha", color: "#8A5A9E" },
];

function uid() {
  return Math.random().toString(36).slice(2, 10) + Date.now().toString(36);
}

function formatBRL(v) {
  return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

function initials(name) {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => p[0]?.toUpperCase())
    .join("");
}

export default function FamilyFinanceApp() {
  const [members, setMembers] = useState(null); // null = loading
  const [transactions, setTransactions] = useState(null);
  const [loadError, setLoadError] = useState(false);
  const [currentUser, setCurrentUser] = useState(null);
  const [view, setView] = useState("overview");

  // load from persistent storage
  useEffect(() => {
    (async () => {
      try {
        let m = [];
        try {
          const res = await window.storage.get(MEMBERS_KEY, true);
          m = res ? JSON.parse(res.value) : [];
        } catch {
          m = [];
        }
        let t = [];
        try {
          const res = await window.storage.get(TX_KEY, true);
          t = res ? JSON.parse(res.value) : [];
        } catch {
          t = [];
        }
        setMembers(m);
        setTransactions(t);
      } catch (e) {
        setLoadError(true);
        setMembers([]);
        setTransactions([]);
      }
    })();
  }, []);

  async function persistMembers(next) {
    setMembers(next);
    try {
      await window.storage.set(MEMBERS_KEY, JSON.stringify(next), true);
    } catch {}
  }

  async function persistTransactions(next) {
    setTransactions(next);
    try {
      await window.storage.set(TX_KEY, JSON.stringify(next), true);
    } catch {}
  }

  if (members === null || transactions === null) {
    return (
      <Shell>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "center", height: "100%", color: "var(--ink-soft)", fontFamily: "var(--font-body)" }}>
          Carregando o cofre da família…
        </div>
      </Shell>
    );
  }

  if (!currentUser) {
    return (
      <Shell>
        <LoginScreen members={members} onCreateMember={async (mem) => { const next = [...members, mem]; await persistMembers(next); setCurrentUser(mem); }} onLogin={setCurrentUser} />
      </Shell>
    );
  }

  return (
    <Shell>
      <Dashboard
        members={members}
        transactions={transactions}
        currentUser={currentUser}
        view={view}
        setView={setView}
        onLogout={() => setCurrentUser(null)}
        onAddTransaction={async (tx) => {
          await persistTransactions([tx, ...transactions]);
        }}
        onDeleteTransaction={async (id) => {
          await persistTransactions(transactions.filter((t) => t.id !== id));
        }}
        onAddMember={async (mem) => {
          await persistMembers([...members, mem]);
        }}
      />
    </Shell>
  );
}

function Shell({ children }) {
  return (
    <div
      style={{
        "--bg": "#EEF3EC",
        "--surface": "#FFFFFF",
        "--surface-alt": "#F5F8F3",
        "--ink": "#1B2A22",
        "--ink-soft": "#5C6E62",
        "--primary": "#1F4D3E",
        "--primary-light": "#3A7360",
        "--accent": "#E2A33D",
        "--positive": "#2F8F5B",
        "--negative": "#C1503D",
        "--border": "#DCE6DD",
        "--font-display": "'Fraunces', serif",
        "--font-body": "'Manrope', sans-serif",
        minHeight: "600px",
        height: "100%",
        background: "var(--bg)",
        fontFamily: "var(--font-body)",
        color: "var(--ink)",
        borderRadius: "12px",
        overflow: "hidden",
      }}
    >
      <style>{FONT_IMPORT}</style>
      {children}
    </div>
  );
}

function Avatar({ name, color, size = 40, ring }) {
  return (
    <div
      style={{
        width: size,
        height: size,
        borderRadius: "50%",
        background: color,
        color: "#fff",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        fontWeight: 700,
        fontSize: size * 0.38,
        fontFamily: "var(--font-display)",
        flexShrink: 0,
        boxShadow: ring ? `0 0 0 3px var(--surface), 0 0 0 5px ${color}55` : "none",
      }}
    >
      {initials(name)}
    </div>
  );
}

function LoginScreen({ members, onCreateMember, onLogin }) {
  const [selected, setSelected] = useState(null);
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");
  const [creating, setCreating] = useState(false);
  const [newName, setNewName] = useState("");
  const [newPass, setNewPass] = useState("");
  const [createError, setCreateError] = useState("");

  function tryLogin() {
    if (!selected) return;
    if (password === selected.password) {
      setError("");
      onLogin(selected);
    } else {
      setError("Senha incorreta. Tente novamente.");
    }
  }

  function submitNewMember(e) {
    e.preventDefault();
    if (!newName.trim() || !newPass.trim()) {
      setCreateError("Preencha nome e senha para continuar.");
      return;
    }
    const color = PALETTE[members.length % PALETTE.length];
    onCreateMember({ id: uid(), name: newName.trim(), password: newPass, color });
    setNewName("");
    setNewPass("");
    setCreateError("");
    setCreating(false);
  }

  function closeCreateForm() {
    setCreating(false);
    setNewName("");
    setNewPass("");
    setCreateError("");
  }

  return (
    <div style={{ minHeight: "600px", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", padding: "48px 24px", textAlign: "center" }}>
      <div style={{ width: 64, height: 64, borderRadius: "18px", background: "var(--primary)", display: "flex", alignItems: "center", justifyContent: "center", marginBottom: 20 }}>
        <Wallet color="var(--accent)" size={30} strokeWidth={2} />
      </div>
      <h1 style={{ fontFamily: "var(--font-display)", fontSize: 34, fontWeight: 700, margin: 0, color: "var(--primary)" }}>Cofre da Família</h1>
      <p style={{ color: "var(--ink-soft)", marginTop: 8, marginBottom: 36, maxWidth: 360, lineHeight: 1.5 }}>
        Cada pessoa entra com seu nome e senha para registrar receitas e despesas da casa.
      </p>

      {!creating && (
        <>
          {members.length > 0 && (
            <div style={{ display: "flex", flexWrap: "wrap", gap: 14, justifyContent: "center", maxWidth: 420, marginBottom: 28 }}>
              {members.map((m) => (
                <button
                  key={m.id}
                  onClick={() => { setSelected(m); setError(""); setPassword(""); }}
                  style={{
                    display: "flex",
                    flexDirection: "column",
                    alignItems: "center",
                    gap: 8,
                    background: "none",
                    border: "none",
                    cursor: "pointer",
                    padding: 6,
                    borderRadius: 12,
                    outline: selected?.id === m.id ? `2px solid var(--primary)` : "none",
                  }}
                >
                  <Avatar name={m.name} color={m.color} size={56} ring={selected?.id === m.id} />
                  <span style={{ fontSize: 13, fontWeight: 600, color: "var(--ink)" }}>{m.name}</span>
                </button>
              ))}
            </div>
          )}

          {selected && (
            <form
              onSubmit={(e) => { e.preventDefault(); tryLogin(); }}
              style={{ display: "flex", flexDirection: "column", gap: 10, width: 260, marginBottom: 20 }}
            >
              <div style={{ position: "relative" }}>
                <Lock size={16} color="var(--ink-soft)" style={{ position: "absolute", left: 12, top: "50%", transform: "translateY(-50%)" }} />
                <input
                  autoFocus
                  type="password"
                  placeholder={`Senha de ${selected.name}`}
                  value={password}
                  onChange={(e) => setPassword(e.target.value)}
                  style={inputStyle(true)}
                />
              </div>
              {error && <span style={{ color: "var(--negative)", fontSize: 13 }}>{error}</span>}
              <button type="submit" style={primaryBtn()}>Entrar</button>
            </form>
          )}

          <button
            onClick={() => { setCreating(true); setSelected(null); }}
            style={{ background: "none", border: "none", color: "var(--primary-light)", fontWeight: 700, cursor: "pointer", fontSize: 14, display: "flex", alignItems: "center", gap: 6 }}
          >
            <Plus size={16} /> {members.length === 0 ? "Criar o primeiro perfil da família" : "Adicionar novo membro"}
          </button>
        </>
      )}

      {creating && (
        <div style={{ position: "relative", width: 280, background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: "20px 20px 16px" }}>
          <button
            type="button"
            onClick={closeCreateForm}
            aria-label="Fechar"
            style={{ position: "absolute", top: 10, right: 10, width: 28, height: 28, borderRadius: "50%", border: "none", background: "var(--surface-alt)", color: "var(--ink-soft)", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}
          >
            <X size={15} />
          </button>
          <h3 style={{ ...cardTitle(), marginBottom: 14, paddingRight: 24 }}>Novo perfil da família</h3>
          <form onSubmit={submitNewMember} style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            <input placeholder="Nome" value={newName} onChange={(e) => setNewName(e.target.value)} style={inputStyle()} autoFocus />
            <input type="password" placeholder="Criar senha" value={newPass} onChange={(e) => setNewPass(e.target.value)} style={inputStyle()} />
            {createError && <span style={{ color: "var(--negative)", fontSize: 13 }}>{createError}</span>}
            <div style={{ display: "flex", gap: 8 }}>
              <button type="button" onClick={closeCreateForm} style={secondaryBtn()}>Voltar</button>
              <button type="submit" style={primaryBtn()}>Criar perfil</button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}

function inputStyle(withIconPadding) {
  return {
    border: "1px solid var(--border)",
    borderRadius: 10,
    padding: withIconPadding ? "11px 12px 11px 36px" : "11px 12px",
    fontSize: 14,
    fontFamily: "var(--font-body)",
    outline: "none",
    background: "var(--surface)",
    color: "var(--ink)",
    width: "100%",
    boxSizing: "border-box",
  };
}

function primaryBtn() {
  return {
    background: "var(--primary)",
    color: "#fff",
    border: "none",
    borderRadius: 10,
    padding: "11px 16px",
    fontWeight: 700,
    fontSize: 14,
    cursor: "pointer",
    flex: 1,
  };
}

function secondaryBtn() {
  return {
    background: "var(--surface-alt)",
    color: "var(--ink)",
    border: "1px solid var(--border)",
    borderRadius: 10,
    padding: "11px 16px",
    fontWeight: 700,
    fontSize: 14,
    cursor: "pointer",
    flex: 1,
  };
}

function Dashboard({ members, transactions, currentUser, view, setView, onLogout, onAddTransaction, onDeleteTransaction, onAddMember }) {
  const [showForm, setShowForm] = useState(false);

  const totals = useMemo(() => {
    let income = 0, expense = 0;
    transactions.forEach((t) => (t.type === "receita" ? (income += t.amount) : (expense += t.amount)));
    return { income, expense, balance: income - expense };
  }, [transactions]);

  const byCategory = useMemo(() => {
    const map = {};
    transactions.filter((t) => t.type === "despesa").forEach((t) => {
      map[t.category] = (map[t.category] || 0) + t.amount;
    });
    return Object.entries(map).map(([name, value]) => ({ name, value }));
  }, [transactions]);

  const byMember = useMemo(() => {
    return members.map((m) => {
      const income = transactions.filter((t) => t.memberId === m.id && t.type === "receita").reduce((s, t) => s + t.amount, 0);
      const expense = transactions.filter((t) => t.memberId === m.id && t.type === "despesa").reduce((s, t) => s + t.amount, 0);
      return { name: m.name.split(" ")[0], income, expense, color: m.color };
    });
  }, [members, transactions]);

  return (
    <div style={{ display: "flex", flexDirection: "column", height: "100%", minHeight: "600px" }}>
      <header style={{ display: "flex", alignItems: "center", justifyContent: "space-between", padding: "16px 24px", borderBottom: "1px solid var(--border)", background: "var(--surface)" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div style={{ width: 34, height: 34, borderRadius: 9, background: "var(--primary)", display: "flex", alignItems: "center", justifyContent: "center" }}>
            <Wallet color="var(--accent)" size={18} />
          </div>
          <span style={{ fontFamily: "var(--font-display)", fontWeight: 700, fontSize: 19, color: "var(--primary)" }}>Cofre da Família</span>
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
          <Avatar name={currentUser.name} color={currentUser.color} size={32} />
          <span style={{ fontSize: 14, fontWeight: 600 }}>{currentUser.name}</span>
          <button onClick={onLogout} title="Sair" style={{ background: "none", border: "none", cursor: "pointer", color: "var(--ink-soft)", display: "flex" }}>
            <LogOut size={18} />
          </button>
        </div>
      </header>

      <nav style={{ display: "flex", gap: 4, padding: "10px 24px", background: "var(--surface)", borderBottom: "1px solid var(--border)" }}>
        <TabBtn icon={LayoutGrid} label="Visão geral" active={view === "overview"} onClick={() => setView("overview")} />
        <TabBtn icon={Receipt} label="Lançamentos" active={view === "transactions"} onClick={() => setView("transactions")} />
        <TabBtn icon={Users} label="Membros" active={view === "members"} onClick={() => setView("members")} />
      </nav>

      <main style={{ flex: 1, overflowY: "auto", padding: 24 }}>
        {view === "overview" && <Overview totals={totals} byCategory={byCategory} byMember={byMember} transactions={transactions} members={members} />}
        {view === "transactions" && (
          <TransactionsView
            transactions={transactions}
            members={members}
            currentUser={currentUser}
            showForm={showForm}
            setShowForm={setShowForm}
            onAddTransaction={onAddTransaction}
            onDeleteTransaction={onDeleteTransaction}
          />
        )}
        {view === "members" && <MembersView members={members} onAddMember={onAddMember} />}
      </main>
    </div>
  );
}

function TabBtn({ icon: Icon, label, active, onClick }) {
  return (
    <button
      onClick={onClick}
      style={{
        display: "flex",
        alignItems: "center",
        gap: 6,
        padding: "8px 14px",
        borderRadius: 8,
        border: "none",
        background: active ? "var(--surface-alt)" : "transparent",
        color: active ? "var(--primary)" : "var(--ink-soft)",
        fontWeight: 700,
        fontSize: 13.5,
        cursor: "pointer",
      }}
    >
      <Icon size={15} /> {label}
    </button>
  );
}

function StatCard({ label, value, icon: Icon, tone }) {
  const color = tone === "positive" ? "var(--positive)" : tone === "negative" ? "var(--negative)" : "var(--primary)";
  return (
    <div style={{ background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: "18px 20px", flex: 1, minWidth: 160 }}>
      <div style={{ display: "flex", alignItems: "center", gap: 8, color: "var(--ink-soft)", fontSize: 13, fontWeight: 600, marginBottom: 8 }}>
        <Icon size={15} color={color} /> {label}
      </div>
      <div style={{ fontFamily: "var(--font-display)", fontSize: 24, fontWeight: 700, color }}>{formatBRL(value)}</div>
    </div>
  );
}

function Overview({ totals, byCategory, byMember, transactions, members }) {
  const recent = transactions.slice(0, 6);
  const memberMap = Object.fromEntries(members.map((m) => [m.id, m]));

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 20 }}>
      <div style={{ display: "flex", gap: 14, flexWrap: "wrap" }}>
        <StatCard label="Saldo da família" value={totals.balance} icon={Wallet} tone={totals.balance >= 0 ? "positive" : "negative"} />
        <StatCard label="Receitas" value={totals.income} icon={TrendingUp} tone="positive" />
        <StatCard label="Despesas" value={totals.expense} icon={TrendingDown} tone="negative" />
      </div>

      <div style={{ display: "flex", gap: 20, flexWrap: "wrap" }}>
        <div style={{ flex: "1 1 320px", background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 20 }}>
          <h3 style={cardTitle()}>Despesas por categoria</h3>
          {byCategory.length === 0 ? (
            <EmptyNote text="Ainda não há despesas registradas." />
          ) : (
            <ResponsiveContainer width="100%" height={220}>
              <PieChart>
                <Pie data={byCategory} dataKey="value" nameKey="name" innerRadius={55} outerRadius={85} paddingAngle={2}>
                  {byCategory.map((_, i) => (
                    <Cell key={i} fill={PALETTE[i % PALETTE.length]} />
                  ))}
                </Pie>
                <Tooltip formatter={(v) => formatBRL(v)} />
              </PieChart>
            </ResponsiveContainer>
          )}
        </div>

        <div style={{ flex: "1 1 320px", background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 20 }}>
          <h3 style={cardTitle()}>Contribuição por membro</h3>
          {byMember.every((m) => m.income === 0 && m.expense === 0) ? (
            <EmptyNote text="Nenhum lançamento por membro ainda." />
          ) : (
            <ResponsiveContainer width="100%" height={220}>
              <BarChart data={byMember}>
                <CartesianGrid strokeDasharray="3 3" stroke="var(--border)" vertical={false} />
                <XAxis dataKey="name" tick={{ fontSize: 12, fill: "var(--ink-soft)" }} axisLine={false} tickLine={false} />
                <YAxis tick={{ fontSize: 11, fill: "var(--ink-soft)" }} axisLine={false} tickLine={false} />
                <Tooltip formatter={(v) => formatBRL(v)} />
                <Bar dataKey="income" fill="var(--positive)" radius={[4, 4, 0, 0]} name="Receitas" />
                <Bar dataKey="expense" fill="var(--negative)" radius={[4, 4, 0, 0]} name="Despesas" />
              </BarChart>
            </ResponsiveContainer>
          )}
        </div>
      </div>

      <div style={{ background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 20 }}>
        <h3 style={cardTitle()}>Últimos lançamentos</h3>
        {recent.length === 0 ? (
          <EmptyNote text="Nenhum lançamento ainda. Registre o primeiro na aba Lançamentos." />
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {recent.map((t) => (
              <TxRow key={t.id} t={t} member={memberMap[t.memberId]} />
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

function cardTitle() {
  return { fontFamily: "var(--font-display)", fontSize: 16, fontWeight: 700, margin: "0 0 14px 0", color: "var(--ink)" };
}

function EmptyNote({ text }) {
  return <p style={{ color: "var(--ink-soft)", fontSize: 13.5, textAlign: "center", padding: "30px 10px" }}>{text}</p>;
}

function TxRow({ t, member, onDelete }) {
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 12, padding: "8px 0", borderBottom: "1px solid var(--surface-alt)" }}>
      <Avatar name={member?.name || "?"} color={member?.color || "#999"} size={30} />
      <div style={{ flex: 1, minWidth: 0 }}>
        <div style={{ fontWeight: 700, fontSize: 13.5, whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis" }}>{t.description}</div>
        <div style={{ fontSize: 12, color: "var(--ink-soft)" }}>{t.category} · {new Date(t.date).toLocaleDateString("pt-BR")}</div>
      </div>
      <div style={{ fontWeight: 700, fontSize: 14, color: t.type === "receita" ? "var(--positive)" : "var(--negative)" }}>
        {t.type === "receita" ? "+" : "−"} {formatBRL(t.amount)}
      </div>
      {onDelete && (
        <button onClick={() => onDelete(t.id)} style={{ background: "none", border: "none", cursor: "pointer", color: "var(--ink-soft)", display: "flex" }}>
          <Trash2 size={14} />
        </button>
      )}
    </div>
  );
}

function TransactionsView({ transactions, members, currentUser, showForm, setShowForm, onAddTransaction, onDeleteTransaction }) {
  const [filterMember, setFilterMember] = useState("all");
  const memberMap = Object.fromEntries(members.map((m) => [m.id, m]));

  const filtered = filterMember === "all" ? transactions : transactions.filter((t) => t.memberId === filterMember);

  return (
    <div>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 16, flexWrap: "wrap", gap: 10 }}>
        <select value={filterMember} onChange={(e) => setFilterMember(e.target.value)} style={{ ...inputStyle(), width: "auto", padding: "8px 12px" }}>
          <option value="all">Todos os membros</option>
          {members.map((m) => (
            <option key={m.id} value={m.id}>{m.name}</option>
          ))}
        </select>
        <button onClick={() => setShowForm(true)} style={{ ...primaryBtn(), display: "flex", alignItems: "center", gap: 6, flex: "none" }}>
          <Plus size={16} /> Novo lançamento
        </button>
      </div>

      {showForm && (
        <NewTransactionForm currentUser={currentUser} onClose={() => setShowForm(false)} onSubmit={(tx) => { onAddTransaction(tx); setShowForm(false); }} />
      )}

      <div style={{ background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 20 }}>
        {filtered.length === 0 ? (
          <EmptyNote text="Nenhum lançamento encontrado." />
        ) : (
          <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            {filtered.map((t) => (
              <TxRow key={t.id} t={t} member={memberMap[t.memberId]} onDelete={onDeleteTransaction} />
            ))}
          </div>
        )}
      </div>
    </div>
  );
}

function NewTransactionForm({ currentUser, onClose, onSubmit }) {
  const [type, setType] = useState("despesa");
  const [description, setDescription] = useState("");
  const [amount, setAmount] = useState("");
  const [category, setCategory] = useState(EXPENSE_CATEGORIES[0]);
  const [date, setDate] = useState(new Date().toISOString().slice(0, 10));

  const categories = type === "despesa" ? EXPENSE_CATEGORIES : INCOME_CATEGORIES;

  function submit(e) {
    e.preventDefault();
    const val = parseFloat(amount.replace(",", "."));
    if (!description.trim() || isNaN(val) || val <= 0) return;
    onSubmit({
      id: uid(),
      memberId: currentUser.id,
      type,
      description: description.trim(),
      amount: val,
      category,
      date,
    });
  }

  return (
    <div style={{ background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 20, marginBottom: 16 }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 14 }}>
        <h3 style={cardTitle()}>Novo lançamento de {currentUser.name}</h3>
        <button onClick={onClose} style={{ background: "none", border: "none", cursor: "pointer", color: "var(--ink-soft)" }}><X size={18} /></button>
      </div>
      <form onSubmit={submit} style={{ display: "flex", flexDirection: "column", gap: 12 }}>
        <div style={{ display: "flex", gap: 8 }}>
          <button type="button" onClick={() => { setType("despesa"); setCategory(EXPENSE_CATEGORIES[0]); }} style={toggleBtn(type === "despesa", "var(--negative)")}>Despesa</button>
          <button type="button" onClick={() => { setType("receita"); setCategory(INCOME_CATEGORIES[0]); }} style={toggleBtn(type === "receita", "var(--positive)")}>Receita</button>
        </div>
        <input placeholder="Descrição (ex: Supermercado)" value={description} onChange={(e) => setDescription(e.target.value)} style={inputStyle()} autoFocus />
        <div style={{ display: "flex", gap: 10 }}>
          <input placeholder="Valor (R$)" inputMode="decimal" value={amount} onChange={(e) => setAmount(e.target.value)} style={inputStyle()} />
          <input type="date" value={date} onChange={(e) => setDate(e.target.value)} style={inputStyle()} />
        </div>
        <select value={category} onChange={(e) => setCategory(e.target.value)} style={inputStyle()}>
          {categories.map((c) => <option key={c} value={c}>{c}</option>)}
        </select>
        <button type="submit" style={primaryBtn()}>Salvar lançamento</button>
      </form>
    </div>
  );
}

function toggleBtn(active, color) {
  return {
    flex: 1,
    padding: "9px 12px",
    borderRadius: 9,
    border: `1.5px solid ${active ? color : "var(--border)"}`,
    background: active ? `${color}18` : "var(--surface)",
    color: active ? color : "var(--ink-soft)",
    fontWeight: 700,
    fontSize: 13.5,
    cursor: "pointer",
  };
}

function MembersView({ members, onAddMember }) {
  const [adding, setAdding] = useState(false);
  const [name, setName] = useState("");
  const [password, setPassword] = useState("");
  const [error, setError] = useState("");

  function submit(e) {
    e.preventDefault();
    if (!name.trim() || !password.trim()) {
      setError("Preencha nome e senha para continuar.");
      return;
    }
    const color = PALETTE[members.length % PALETTE.length];
    onAddMember({ id: uid(), name: name.trim(), password, color });
    setName("");
    setPassword("");
    setError("");
    setAdding(false);
  }

  function closeForm() {
    setAdding(false);
    setName("");
    setPassword("");
    setError("");
  }

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
      <div style={{ display: "flex", flexWrap: "wrap", gap: 14 }}>
        {members.map((m) => (
          <div key={m.id} style={{ background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: 16, display: "flex", alignItems: "center", gap: 12, width: 200 }}>
            <Avatar name={m.name} color={m.color} size={44} />
            <div>
              <div style={{ fontWeight: 700, fontSize: 14 }}>{m.name}</div>
              <div style={{ fontSize: 12, color: "var(--ink-soft)" }}>Membro da família</div>
            </div>
          </div>
        ))}
        <button
          onClick={() => setAdding(true)}
          style={{ width: 200, border: "1.5px dashed var(--border)", borderRadius: 14, background: "none", display: "flex", flexDirection: "column", alignItems: "center", justifyContent: "center", gap: 6, color: "var(--primary-light)", cursor: "pointer", fontWeight: 700, fontSize: 13.5 }}
        >
          <Plus size={20} /> Adicionar membro
        </button>
      </div>

      {adding && (
        <div style={{ position: "relative", maxWidth: 300, background: "var(--surface)", border: "1px solid var(--border)", borderRadius: 14, padding: "20px 20px 16px" }}>
          <button
            type="button"
            onClick={closeForm}
            aria-label="Fechar"
            style={{ position: "absolute", top: 10, right: 10, width: 28, height: 28, borderRadius: "50%", border: "none", background: "var(--surface-alt)", color: "var(--ink-soft)", cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center" }}
          >
            <X size={15} />
          </button>
          <h3 style={{ ...cardTitle(), marginBottom: 14, paddingRight: 24 }}>Novo membro</h3>
          <form onSubmit={submit} style={{ display: "flex", flexDirection: "column", gap: 10 }}>
            <input placeholder="Nome" value={name} onChange={(e) => setName(e.target.value)} style={inputStyle()} autoFocus />
            <input type="password" placeholder="Criar senha" value={password} onChange={(e) => setPassword(e.target.value)} style={inputStyle()} />
            {error && <span style={{ color: "var(--negative)", fontSize: 13 }}>{error}</span>}
            <div style={{ display: "flex", gap: 8 }}>
              <button type="button" onClick={closeForm} style={secondaryBtn()}>Voltar</button>
              <button type="submit" style={primaryBtn()}>Criar</button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}
