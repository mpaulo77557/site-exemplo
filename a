import React, { useState, useEffect, useCallback } from "react";
import { Plus, Trash2, LogOut, User, Lock, TrendingUp, TrendingDown, Wallet, Users } from "lucide-react";

const STORAGE_USERS_KEY = "familia:usuarios";
const STORAGE_LANC_PREFIX = "familia:lancamentos";

const CATEGORIAS_ENTRADA = ["Salário", "Doceria", "Extra", "Outro"];
const CATEGORIAS_SAIDA = ["Moradia", "Alimentação", "Transporte", "Saúde", "Educação", "Doceria", "Lazer", "Outro"];

function formatBRL(v) {
  return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

function formatDate(iso) {
  const d = new Date(iso + "T00:00:00");
  return d.toLocaleDateString("pt-BR");
}

export default function FinancasFamilia() {
  const [carregando, setCarregando] = useState(true);
  const [erro, setErro] = useState("");
  const [usuarios, setUsuarios] = useState({});
  const [usuarioLogado, setUsuarioLogado] = useState(null);

  const [telaAuth, setTelaAuth] = useState("login"); // "login" | "cadastro"
  const [nomeInput, setNomeInput] = useState("");
  const [senhaInput, setSenhaInput] = useState("");
  const [senhaConfirma, setSenhaConfirma] = useState("");
  const [authErro, setAuthErro] = useState("");

  const [lancamentos, setLancamentos] = useState([]);
  const [filtroTipo, setFiltroTipo] = useState("todos"); // todos | entrada | saida
  const [filtroPessoa, setFiltroPessoa] = useState("todos");

  const [formTipo, setFormTipo] = useState("saida");
  const [formDescricao, setFormDescricao] = useState("");
  const [formValor, setFormValor] = useState("");
  const [formCategoria, setFormCategoria] = useState(CATEGORIAS_SAIDA[0]);
  const [formData, setFormData] = useState(() => new Date().toISOString().slice(0, 10));
  const [formErro, setFormErro] = useState("");

  // Carrega usuários e lançamentos compartilhados ao iniciar
  useEffect(() => {
    async function carregar() {
      try {
        const usuariosResult = await window.storage.get(STORAGE_USERS_KEY, true);
        if (usuariosResult && usuariosResult.value) {
          setUsuarios(JSON.parse(usuariosResult.value));
        }
      } catch (e) {
        // chave ainda não existe, tudo bem
      }
      try {
        const lancResult = await window.storage.get(STORAGE_LANC_PREFIX, true);
        if (lancResult && lancResult.value) {
          setLancamentos(JSON.parse(lancResult.value));
        }
      } catch (e) {
        // chave ainda não existe, tudo bem
      }
      setCarregando(false);
    }
    carregar();
  }, []);

  const salvarUsuarios = useCallback(async (novosUsuarios) => {
    try {
      const result = await window.storage.set(STORAGE_USERS_KEY, JSON.stringify(novosUsuarios), true);
      if (!result) {
        setErro("Não foi possível salvar os dados de usuários. Tente novamente.");
      }
    } catch (e) {
      setErro("Erro ao salvar usuários.");
    }
  }, []);

  const salvarLancamentos = useCallback(async (novosLancamentos) => {
    try {
      const result = await window.storage.set(STORAGE_LANC_PREFIX, JSON.stringify(novosLancamentos), true);
      if (!result) {
        setErro("Não foi possível salvar o lançamento. Tente novamente.");
      }
    } catch (e) {
      setErro("Erro ao salvar lançamentos.");
    }
  }, []);

  function handleCadastro(e) {
    e.preventDefault();
    setAuthErro("");
    const nome = nomeInput.trim();
    if (!nome) {
      setAuthErro("Digite um nome.");
      return;
    }
    if (senhaInput.length < 4) {
      setAuthErro("A senha precisa ter pelo menos 4 caracteres.");
      return;
    }
    if (senhaInput !== senhaConfirma) {
      setAuthErro("As senhas não coincidem.");
      return;
    }
    const chave = nome.toLowerCase();
    if (usuarios[chave]) {
      setAuthErro("Já existe alguém cadastrado com esse nome.");
      return;
    }
    const novosUsuarios = { ...usuarios, [chave]: { nome, senha: senhaInput } };
    setUsuarios(novosUsuarios);
    salvarUsuarios(novosUsuarios);
    setUsuarioLogado(nome);
    setNomeInput("");
    setSenhaInput("");
    setSenhaConfirma("");
  }

  function handleLogin(e) {
    e.preventDefault();
    setAuthErro("");
    const nome = nomeInput.trim();
    const chave = nome.toLowerCase();
    const usuario = usuarios[chave];
    if (!usuario || usuario.senha !== senhaInput) {
      setAuthErro("Nome ou senha incorretos.");
      return;
    }
    setUsuarioLogado(usuario.nome);
    setNomeInput("");
    setSenhaInput("");
  }

  function handleLogout() {
    setUsuarioLogado(null);
    setFiltroTipo("todos");
    setFiltroPessoa("todos");
  }

  function handleAddLancamento(e) {
    e.preventDefault();
    setFormErro("");
    const valorNum = parseFloat(formValor.replace(",", "."));
    if (!formDescricao.trim()) {
      setFormErro("Descreva o lançamento.");
      return;
    }
    if (isNaN(valorNum) || valorNum <= 0) {
      setFormErro("Digite um valor válido maior que zero.");
      return;
    }
    const novo = {
      id: Date.now().toString() + Math.random().toString(36).slice(2, 7),
      tipo: formTipo,
      descricao: formDescricao.trim(),
      valor: valorNum,
      categoria: formCategoria,
      data: formData,
      autor: usuarioLogado,
      criadoEm: new Date().toISOString(),
    };
    const atualizados = [novo, ...lancamentos];
    setLancamentos(atualizados);
    salvarLancamentos(atualizados);
    setFormDescricao("");
    setFormValor("");
  }

  function handleRemoverLancamento(id) {
    const atualizados = lancamentos.filter((l) => l.id !== id);
    setLancamentos(atualizados);
    salvarLancamentos(atualizados);
  }

  useEffect(() => {
    setFormCategoria(formTipo === "entrada" ? CATEGORIAS_ENTRADA[0] : CATEGORIAS_SAIDA[0]);
  }, [formTipo]);

  if (carregando) {
    return (
      <div style={{ display: "flex", justifyContent: "center", padding: "3rem", color: "var(--text-secondary)" }}>
        Carregando…
      </div>
    );
  }

  // TELA DE AUTENTICAÇÃO
  if (!usuarioLogado) {
    const paleta = {
      pergaminho: "#F2E9D8",
      pergaminhoEscuro: "#E4D5B7",
      tintaSepia: "#4A3728",
      oliva: "#6B7654",
      olivaEscuro: "#4E5A3B",
      terracota: "#B5652D",
      linha: "#C9B995",
    };
    return (
      <div style={{ maxWidth: 440, margin: "0 auto", padding: "1.5rem 1rem" }}>
        <style>{`
          @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Space+Mono:wght@400;700&display=swap');
          .lb-serif { font-family: 'Fraunces', var(--font-voice), serif; }
          .lb-mono { font-family: 'Space Mono', var(--font-mono), monospace; }
          .lb-input::placeholder { color: #8A7A63; opacity: 1; }
          .lb-input:focus { outline: none; box-shadow: 0 0 0 2px ${paleta.terracota}33; }
          .lb-tab { transition: color 0.2s ease; }
          .lb-btn { transition: transform 0.15s ease, box-shadow 0.15s ease; }
          .lb-btn:active { transform: translateY(1px); }
        `}</style>

        <div
          style={{
            background: paleta.pergaminho,
            border: `1px solid ${paleta.linha}`,
            borderRadius: 4,
            boxShadow: "0 1px 3px rgba(74,55,40,0.08), 0 8px 24px rgba(74,55,40,0.08)",
            position: "relative",
            overflow: "hidden",
          }}
        >
          {/* aba de caderno de contas */}
          <div
            style={{
              position: "absolute",
              top: 0,
              left: 32,
              width: 96,
              height: 14,
              background: paleta.terracota,
              borderRadius: "0 0 6px 6px",
            }}
          />
          <div
            style={{
              padding: "2.5rem 2rem 1.75rem",
              borderBottom: `1px solid ${paleta.linha}`,
              textAlign: "center",
            }}
          >
            <p
              className="lb-mono"
              style={{
                fontSize: 11,
                letterSpacing: "0.14em",
                textTransform: "uppercase",
                color: paleta.oliva,
                margin: "0 0 10px",
                fontWeight: 700,
              }}
            >
              Livro-caixa da família
            </p>
            <h1
              className="lb-serif"
              style={{
                fontSize: 30,
                fontWeight: 600,
                fontStyle: "italic",
                color: paleta.tintaSepia,
                margin: 0,
                lineHeight: 1.15,
              }}
            >
              Contas em ordem,
              <br />
              família em paz
            </h1>
            <div
              style={{
                width: 40,
                height: 2,
                background: paleta.terracota,
                margin: "16px auto 0",
                borderRadius: 2,
              }}
            />
          </div>

          <div style={{ padding: "1.5rem 2rem 2rem" }}>
            <div
              style={{
                display: "flex",
                marginBottom: "1.5rem",
                borderBottom: `1px solid ${paleta.linha}`,
              }}
            >
              <button
                className="lb-tab"
                onClick={() => {
                  setTelaAuth("login");
                  setAuthErro("");
                }}
                style={{
                  flex: 1,
                  background: "none",
                  border: "none",
                  borderBottom: telaAuth === "login" ? `2px solid ${paleta.terracota}` : "2px solid transparent",
                  marginBottom: -1,
                  padding: "0 0 10px",
                  fontFamily: "'Space Mono', monospace",
                  fontSize: 12,
                  letterSpacing: "0.06em",
                  textTransform: "uppercase",
                  fontWeight: telaAuth === "login" ? 700 : 400,
                  color: telaAuth === "login" ? paleta.tintaSepia : "#9B8B72",
                  cursor: "pointer",
                }}
              >
                Entrar
              </button>
              <button
                className="lb-tab"
                onClick={() => {
                  setTelaAuth("cadastro");
                  setAuthErro("");
                }}
                style={{
                  flex: 1,
                  background: "none",
                  border: "none",
                  borderBottom: telaAuth === "cadastro" ? `2px solid ${paleta.terracota}` : "2px solid transparent",
                  marginBottom: -1,
                  padding: "0 0 10px",
                  fontFamily: "'Space Mono', monospace",
                  fontSize: 12,
                  letterSpacing: "0.06em",
                  textTransform: "uppercase",
                  fontWeight: telaAuth === "cadastro" ? 700 : 400,
                  color: telaAuth === "cadastro" ? paleta.tintaSepia : "#9B8B72",
                  cursor: "pointer",
                }}
              >
                Criar conta
              </button>
            </div>

            <form
              onSubmit={telaAuth === "login" ? handleLogin : handleCadastro}
              style={{ display: "flex", flexDirection: "column", gap: 14 }}
            >
              <div>
                <label
                  className="lb-mono"
                  style={{
                    fontSize: 10,
                    letterSpacing: "0.1em",
                    textTransform: "uppercase",
                    color: paleta.oliva,
                    display: "flex",
                    alignItems: "center",
                    gap: 6,
                    marginBottom: 6,
                    fontWeight: 700,
                  }}
                >
                  <User size={12} /> Nome
                </label>
                <input
                  className="lb-input"
                  type="text"
                  value={nomeInput}
                  onChange={(e) => setNomeInput(e.target.value)}
                  placeholder="Como você se chama"
                  style={{
                    width: "100%",
                    background: "#FCF8EF",
                    border: `1px solid ${paleta.linha}`,
                    borderRadius: 4,
                    padding: "9px 12px",
                    fontSize: 14,
                    color: paleta.tintaSepia,
                    fontFamily: "inherit",
                    boxSizing: "border-box",
                  }}
                />
              </div>

              <div>
                <label
                  className="lb-mono"
                  style={{
                    fontSize: 10,
                    letterSpacing: "0.1em",
                    textTransform: "uppercase",
                    color: paleta.oliva,
                    display: "flex",
                    alignItems: "center",
                    gap: 6,
                    marginBottom: 6,
                    fontWeight: 700,
                  }}
                >
                  <Lock size={12} /> Senha
                </label>
                <input
                  className="lb-input"
                  type="password"
                  value={senhaInput}
                  onChange={(e) => setSenhaInput(e.target.value)}
                  placeholder="Sua senha"
                  style={{
                    width: "100%",
                    background: "#FCF8EF",
                    border: `1px solid ${paleta.linha}`,
                    borderRadius: 4,
                    padding: "9px 12px",
                    fontSize: 14,
                    color: paleta.tintaSepia,
                    fontFamily: "inherit",
                    boxSizing: "border-box",
                  }}
                />
              </div>

              {telaAuth === "cadastro" && (
                <div>
                  <label
                    className="lb-mono"
                    style={{
                      fontSize: 10,
                      letterSpacing: "0.1em",
                      textTransform: "uppercase",
                      color: paleta.oliva,
                      display: "flex",
                      alignItems: "center",
                      gap: 6,
                      marginBottom: 6,
                      fontWeight: 700,
                    }}
                  >
                    <Lock size={12} /> Confirmar senha
                  </label>
                  <input
                    className="lb-input"
                    type="password"
                    value={senhaConfirma}
                    onChange={(e) => setSenhaConfirma(e.target.value)}
                    placeholder="Repita a senha"
                    style={{
                      width: "100%",
                      background: "#FCF8EF",
                      border: `1px solid ${paleta.linha}`,
                      borderRadius: 4,
                      padding: "9px 12px",
                      fontSize: 14,
                      color: paleta.tintaSepia,
                      fontFamily: "inherit",
                      boxSizing: "border-box",
                    }}
                  />
                </div>
              )}

              {authErro && (
                <p style={{ fontSize: 13, color: "#9C3B2E", margin: 0 }}>{authErro}</p>
              )}

              <button
                className="lb-btn"
                type="submit"
                style={{
                  marginTop: 6,
                  background: paleta.olivaEscuro,
                  color: "#F2E9D8",
                  border: "none",
                  borderRadius: 4,
                  padding: "11px 0",
                  fontSize: 13,
                  letterSpacing: "0.04em",
                  fontWeight: 500,
                  fontFamily: "'Fraunces', serif",
                  cursor: "pointer",
                  boxShadow: "0 2px 0 rgba(74,55,40,0.25)",
                }}
              >
                {telaAuth === "login" ? "Entrar no livro-caixa" : "Abrir minha conta"}
              </button>
            </form>
          </div>
        </div>

        <p
          className="lb-mono"
          style={{
            fontSize: 11,
            color: "#8A7A63",
            textAlign: "center",
            marginTop: 16,
            letterSpacing: "0.02em",
          }}
        >
          Toda conta criada aqui compartilha o mesmo livro-caixa da família.
        </p>
      </div>
    );
  }

  // APP PRINCIPAL (logado)
  const lancamentosFiltrados = lancamentos.filter((l) => {
    if (filtroTipo !== "todos" && l.tipo !== filtroTipo) return false;
    if (filtroPessoa !== "todos" && l.autor !== filtroPessoa) return false;
    return true;
  });

  const totalEntradas = lancamentos.filter((l) => l.tipo === "entrada").reduce((acc, l) => acc + l.valor, 0);
  const totalSaidas = lancamentos.filter((l) => l.tipo === "saida").reduce((acc, l) => acc + l.valor, 0);
  const saldo = totalEntradas - totalSaidas;

  const nomesPessoas = Array.from(new Set(lancamentos.map((l) => l.autor)));

  return (
    <div style={{ maxWidth: 720, margin: "0 auto", padding: "1rem" }}>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "1.25rem" }}>
        <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
          <div
            style={{
              width: 36,
              height: 36,
              borderRadius: "50%",
              background: "var(--bg-accent)",
              display: "flex",
              alignItems: "center",
              justifyContent: "center",
              fontWeight: 500,
              fontSize: 14,
              color: "var(--text-accent)",
            }}
          >
            {usuarioLogado.slice(0, 1).toUpperCase()}
          </div>
          <div>
            <p style={{ fontWeight: 500, fontSize: 15, margin: 0 }}>{usuarioLogado}</p>
            <p style={{ fontSize: 12, color: "var(--text-secondary)", margin: 0 }}>Finanças da família</p>
          </div>
        </div>
        <button onClick={handleLogout} style={{ display: "flex", alignItems: "center", gap: 6, fontSize: 13 }}>
          <LogOut size={14} /> Sair
        </button>
      </div>

      {erro && (
        <p style={{ fontSize: 13, color: "var(--text-danger)", marginBottom: 12 }}>{erro}</p>
      )}

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))",
          gap: 12,
          marginBottom: "1.5rem",
        }}
      >
        <div style={{ background: "var(--surface-1)", borderRadius: "var(--radius)", padding: "1rem" }}>
          <p style={{ fontSize: 13, color: "var(--text-secondary)", margin: "0 0 4px", display: "flex", alignItems: "center", gap: 6 }}>
            <TrendingUp size={14} /> Entradas
          </p>
          <p style={{ fontSize: 20, fontWeight: 500, margin: 0, color: "var(--text-success)" }}>{formatBRL(totalEntradas)}</p>
        </div>
        <div style={{ background: "var(--surface-1)", borderRadius: "var(--radius)", padding: "1rem" }}>
          <p style={{ fontSize: 13, color: "var(--text-secondary)", margin: "0 0 4px", display: "flex", alignItems: "center", gap: 6 }}>
            <TrendingDown size={14} /> Saídas
          </p>
          <p style={{ fontSize: 20, fontWeight: 500, margin: 0, color: "var(--text-danger)" }}>{formatBRL(totalSaidas)}</p>
        </div>
        <div style={{ background: "var(--surface-1)", borderRadius: "var(--radius)", padding: "1rem" }}>
          <p style={{ fontSize: 13, color: "var(--text-secondary)", margin: "0 0 4px", display: "flex", alignItems: "center", gap: 6 }}>
            <Wallet size={14} /> Saldo
          </p>
          <p style={{ fontSize: 20, fontWeight: 500, margin: 0, color: saldo >= 0 ? "var(--text-success)" : "var(--text-danger)" }}>
            {formatBRL(saldo)}
          </p>
        </div>
      </div>

      <form
        onSubmit={handleAddLancamento}
        style={{
          background: "var(--surface-2)",
          border: "0.5px solid var(--border)",
          borderRadius: 12,
          padding: "1.25rem",
          marginBottom: "1.5rem",
          display: "flex",
          flexDirection: "column",
          gap: 10,
        }}
      >
        <p style={{ fontWeight: 500, fontSize: 15, margin: "0 0 4px" }}>Novo lançamento</p>

        <div style={{ display: "flex", gap: 8 }}>
          <button
            type="button"
            onClick={() => setFormTipo("entrada")}
            style={{
              flex: 1,
              borderColor: formTipo === "entrada" ? "var(--border-strong)" : "var(--border)",
              fontWeight: formTipo === "entrada" ? 500 : 400,
              color: formTipo === "entrada" ? "var(--text-success)" : "var(--text-primary)",
            }}
          >
            Entrada
          </button>
          <button
            type="button"
            onClick={() => setFormTipo("saida")}
            style={{
              flex: 1,
              borderColor: formTipo === "saida" ? "var(--border-strong)" : "var(--border)",
              fontWeight: formTipo === "saida" ? 500 : 400,
              color: formTipo === "saida" ? "var(--text-danger)" : "var(--text-primary)",
            }}
          >
            Saída
          </button>
        </div>

        <input
          type="text"
          value={formDescricao}
          onChange={(e) => setFormDescricao(e.target.value)}
          placeholder="Descrição (ex: Conta de luz, Venda de bolo)"
          style={{ width: "100%" }}
        />

        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 8 }}>
          <input
            type="text"
            inputMode="decimal"
            value={formValor}
            onChange={(e) => setFormValor(e.target.value)}
            placeholder="Valor (R$)"
            style={{ width: "100%" }}
          />
          <input
            type="date"
            value={formData}
            onChange={(e) => setFormData(e.target.value)}
            style={{ width: "100%" }}
          />
        </div>

        <select value={formCategoria} onChange={(e) => setFormCategoria(e.target.value)} style={{ width: "100%" }}>
          {(formTipo === "entrada" ? CATEGORIAS_ENTRADA : CATEGORIAS_SAIDA).map((c) => (
            <option key={c} value={c}>
              {c}
            </option>
          ))}
        </select>

        {formErro && <p style={{ fontSize: 13, color: "var(--text-danger)", margin: 0 }}>{formErro}</p>}

        <button type="submit" style={{ fontWeight: 500, display: "flex", alignItems: "center", justifyContent: "center", gap: 6 }}>
          <Plus size={16} /> Adicionar lançamento
        </button>
      </form>

      <div style={{ display: "flex", gap: 8, marginBottom: "1rem", flexWrap: "wrap" }}>
        <select value={filtroTipo} onChange={(e) => setFiltroTipo(e.target.value)}>
          <option value="todos">Todos os tipos</option>
          <option value="entrada">Só entradas</option>
          <option value="saida">Só saídas</option>
        </select>
        <select value={filtroPessoa} onChange={(e) => setFiltroPessoa(e.target.value)}>
          <option value="todos">Todas as pessoas</option>
          {nomesPessoas.map((n) => (
            <option key={n} value={n}>
              {n}
            </option>
          ))}
        </select>
      </div>

      <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
        {lancamentosFiltrados.length === 0 && (
          <p style={{ fontSize: 14, color: "var(--text-muted)", textAlign: "center", padding: "2rem 0" }}>
            Nenhum lançamento por aqui ainda.
          </p>
        )}
        {lancamentosFiltrados.map((l) => (
          <div
            key={l.id}
            style={{
              background: "var(--surface-2)",
              border: "0.5px solid var(--border)",
              borderRadius: "var(--radius)",
              padding: "0.75rem 1rem",
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              gap: 12,
            }}
          >
            <div style={{ minWidth: 0 }}>
              <p style={{ fontSize: 14, fontWeight: 500, margin: 0, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                {l.descricao}
              </p>
              <p style={{ fontSize: 12, color: "var(--text-secondary)", margin: "2px 0 0", display: "flex", alignItems: "center", gap: 6, flexWrap: "wrap" }}>
                <span>{l.categoria}</span>
                <span>·</span>
                <span>{formatDate(l.data)}</span>
                <span>·</span>
                <span style={{ display: "flex", alignItems: "center", gap: 4 }}>
                  <Users size={11} /> {l.autor}
                </span>
              </p>
            </div>
            <div style={{ display: "flex", alignItems: "center", gap: 10, flexShrink: 0 }}>
              <span
                style={{
                  fontSize: 14,
                  fontWeight: 500,
                  color: l.tipo === "entrada" ? "var(--text-success)" : "var(--text-danger)",
                  whiteSpace: "nowrap",
                }}
              >
                {l.tipo === "entrada" ? "+" : "-"} {formatBRL(l.valor)}
              </span>
              <button
                onClick={() => handleRemoverLancamento(l.id)}
                aria-label="Remover lançamento"
                style={{ padding: 6, borderRadius: "var(--radius)" }}
              >
                <Trash2 size={14} />
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
